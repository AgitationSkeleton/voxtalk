/* rules for schwa substitution */
NOT_FOUND ANY-&-ANY -> ANY-OLD,OLD-ANY
NOT_FOUND ANY-& -> ANY-OLD
NOT_FOUND &-ANY -> OLD-ANY

/* rules for unaspirated -> aspirated stops */
NOT_FOUND ANY-P -> ANY-p
NOT_FOUND P-ANY -> p-ANY
NOT_FOUND ANY-+ -> ANY-t
NOT_FOUND +-ANY -> t-ANY
NOT_FOUND ANY-K -> ANY-k
NOT_FOUND K-ANY -> k-ANY

/* in conjunction with OLD, which is set in reduct module, /r/ -> /R/, but
   only in certain cases */
NOT_FOUND r-ANY -> R-ANY
EXISTS r-VOWEL|DIPHTHONG -> OLD-VOWEL|DIPHTHONG

/* diphthong substitution rules */
NOT_FOUND ANY-A -> ANY-e
NOT_FOUND ANY-Y -> ANY->
NOT_FOUND ANY-W -> ANY-o
NOT_FOUND ANY-O -> ANY->
NOT_FOUND ANY-I -> ANY-o

don't need this rule: EXISTS h -> NULL

