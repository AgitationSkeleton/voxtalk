#include <windows.h>
#include "resource.h"

IDI_APP ICON "voxtalk.ico"
IDR_ENGINE RCDATA "../build/engine.pak"
1 RT_MANIFEST "voxtalk.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "voxtalk - FlexTalk VOX-style text-to-speech"
      VALUE "FileVersion", "1.1.0"
      VALUE "ProductName", "voxtalk"
      VALUE "ProductVersion", "1.1.0"
      VALUE "OriginalFilename", "voxtalk.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
